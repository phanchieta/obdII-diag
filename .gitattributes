# Normalise line endings so the repo works the same on Windows and Linux.
* text=auto

# Windows scripts need CRLF, shell scripts need LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Source and data files: always LF.
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Binary
*.png binary
*.jpg binary
